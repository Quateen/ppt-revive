# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Domains (DNS A records for both must point at this server)
APP_DOMAIN=revive.nucleusdigitalis.com
API_DOMAIN=api.revive.nucleusdigitalis.com

# Database
MYSQL_ROOT_PASSWORD=<generate: openssl rand -hex 16>

# JWT signing keys (generate two different long random strings)
JWT_ADMIN_SECRET_KEY=<generate: openssl rand -hex 32>
JWT_SECRET_KEY=<generate: openssl rand -hex 32>

# Anthropic API key (console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...
# Optional: override the Claude model used for slide analysis
CLAUDE_MODEL=claude-opus-4-8

# NCBI E-utilities key (free: ncbi.nlm.nih.gov/account → Settings → API Key)
PUBMED_API_KEY=

# SMTP for transactional email (registration OTP, password reset). Required if you
# enable email/password signup; leave blank to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USESSL=true

# Optional: Google OAuth client id. Used by the frontend login button AND by the
# backend to cryptographically validate Google ID tokens. Google login is refused
# unless this is set.
GOOGLE_OAUTH_CLIENT_ID=

# --- Lead-magnet funnel ---
# Free tier: how many slides a visitor can revive without an account.
FREE_TIER_SLIDES=5
# Where the "Join Founding Members" CTA sends prospects (swap for the live URL).
FOUNDING_URL=https://nucleusdigitalis.com
# Optional: enable cookieless Plausible analytics (leave blank to disable).
PLAUSIBLE_DOMAIN=
