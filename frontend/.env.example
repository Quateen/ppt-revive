# Base URL of the PPT Revive .NET backend API (all AI/PubMed work happens there)
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth client ID used for "Sign in with Google"
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# localStorage key under which the authenticated user/session is stored
VITE_STORAGE_KEY=ppt-revive-user

# Maximum number of slides allowed per uploaded presentation (default: 20)
VITE_MAX_PPT_SLIDES=20

# Maximum upload file size in megabytes (default: 5)
VITE_MAX_PPT_FILE_SIZE_MB=5
